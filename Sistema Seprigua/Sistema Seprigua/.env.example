# SEPRIGUA - ejemplo de configuración (NO subir .env real a GitHub)
# SQL Server
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=SERVIDOR_SQL,1433
DB_NAME=SEPRIGUA_DB
DB_USER=usuario_seprigua
DB_PASSWORD=cambia_esta_clave
DB_TRUST_CERT=yes
DB_QUERY_TIMEOUT=30

# Servidor web
HOST=127.0.0.1
PORT=5000
WAITRESS_THREADS=4
FLASK_DEBUG=0
APP_TIMEZONE=America/Guatemala
TRUST_PROXY_HEADERS=0
ENABLE_HSTS=0
COOKIE_SECURE=0
COOKIE_SAMESITE=Lax
SESSION_HOURS=8
REMEMBER_SESSION_HOURS=168
PUBLIC_ORIGIN=

# Límites de archivos
MAX_UPLOAD_MB=30
MAX_IMAGE_MB=12
MAX_PDF_MB=20
MAX_VIDEO_MB=30
MAX_LABOR_DOCUMENT_MB=20
IMAGE_MAX_DIMENSION=2400
IMAGE_WEBP_QUALITY=86
UPLOAD_ROOT=
LABOR_DOCUMENT_STORAGE_ROOT=
OT_MIN_WORK_PHOTOS=1
COLLAGE_MAX_PHOTOS=8

# Correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SEPRIGUA
SMTP_USE_TLS=1
SMTP_USE_SSL=0
CONTACT_EMAIL_TO=
CONTACT_SEND_CONFIRMATION=0

# Recuperación de contraseña
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_PUBLIC_ORIGIN=
PASSWORD_RESET_SECRET_FILE=
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_IP_WINDOW_SECONDS=3600
PASSWORD_RESET_IDENTITY_LIMIT=5
PASSWORD_RESET_IDENTITY_WINDOW_SECONDS=3600
PASSWORD_RESET_CONFIRM_LIMIT=10
PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=3600

# Seguridad de login/contacto
LOGIN_ACCOUNT_MAX_ATTEMPTS=5
LOGIN_ACCOUNT_LOCK_MINUTES=15
LOGIN_IP_LIMIT=30
LOGIN_IP_WINDOW_SECONDS=900
LOGIN_IDENTITY_LIMIT=10
LOGIN_IDENTITY_WINDOW_SECONDS=900
CONTACT_IP_LIMIT=10
CONTACT_IP_WINDOW_SECONDS=3600
CONTACT_EMAIL_LIMIT=5
CONTACT_EMAIL_WINDOW_SECONDS=3600

# Cloudflare Turnstile (opcional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push
VAPID_SUBJECT=mailto:administracion@ejemplo.com
VAPID_PRIVATE_KEY_FILE=
