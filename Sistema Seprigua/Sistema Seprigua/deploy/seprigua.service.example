[Unit]
Description=Portal SEPRIGUA
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=seprigua
Group=seprigua
WorkingDirectory=/opt/seprigua
ExecStart=/opt/seprigua/.venv/bin/python -m backend.run_waitress
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
